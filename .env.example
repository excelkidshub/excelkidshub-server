# ============================================================
# ExcelKidsHub Platform — Environment Variables Template
# ============================================================
# This file is committed to Git as a reference only.
# It contains NO real secrets — only placeholder values.
#
# HOW TO USE:
#   Local dev   → Set these as shell env vars or IDE run config
#   Production  → Set these in /opt/excelkidshub/.env on the server
#
# NEVER commit a file with real secrets to Git.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────
# Production: use the pooled connection URL from Neon dashboard
# Local dev:  use localhost
DATABASE_URL=jdbc:postgresql://localhost:5432/excelkidshub_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 32
# Must be at least 64 hex characters (256 bits)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION=86400000

# ── Razorpay ──────────────────────────────────────────────────
# Test keys: https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for dev, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── Email (Gmail SMTP) ────────────────────────────────────────
# Use a Gmail App Password (NOT your account login password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@excelkidshub.in
MAIL_PASSWORD=CHANGE_ME_gmail_app_password
MAIL_FROM=noreply@excelkidshub.in
MAIL_FROM_NAME=ExcelKidsHub

# ── Frontend URLs ─────────────────────────────────────────────
FRONTEND_MAIN_URL=https://excelkidshub.in
FRONTEND_READ_URL=https://read.excelkidshub.in
CORS_ALLOWED_ORIGINS=https://excelkidshub.in,https://read.excelkidshub.in

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080
